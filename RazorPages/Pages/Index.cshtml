@page
@model RazorPages.Pages.IndexModel
@{
    ViewData["Title"] = "Class Table";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<h2>Class Table</h2>

@if (HttpContext.Session.GetString("username") == null)
{
    <a href="/Login">Login</a>
}
else
{
    <p>Welcome, @HttpContext.Session.GetString("username")!</p>
    <p>Role: @HttpContext.Session.GetString("role")</p>
    <p>Active: @HttpContext.Session.GetString("isActive")</p>
    <p>Created At: @HttpContext.Session.GetString("createdAt")</p>
    <a href="/Logout">Logout</a> <!-- Show Logout link if user is logged in -->
}

<form method="get">
    <input type="text" name="FilterName" value="@Model.FilterName" placeholder="Filter by Class Name" />
    <button type="submit">Filter</button>
</form>

<br />

<table>
    <thead>
        <tr>
            <th>Class Name</th>
            <th>Student Count</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ClassList)
        {
            <tr>
                <form method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <td><input type="text" name="ClassName" value="@item.ClassName" /></td>
                    <td><input type="number" name="StudentCount" value="@item.StudentCount" /></td>
                    <td><input type="text" name="Description" value="@item.Description" /></td>
                    <td>
                        <!-- Edit button with pencil icon (orange) -->
                        <button type="submit" formaction="?handler=Edit" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </button>

                        <!-- Delete button with trash can icon (red) -->
                        <button type="submit" formaction="?handler=Delete" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>

<br />

<div>
    Page @Model.CurrentPage of @Model.TotalPages
</div>

<div>
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-FilterName="@Model.FilterName">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <strong>@i</strong>
        }
        else
        {
            <a asp-page="./Index" asp-route-CurrentPage="@i" asp-route-FilterName="@Model.FilterName">@i</a>
        }
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-FilterName="@Model.FilterName">Next</a>
    }
</div>

<br />

<h3>Add New Class</h3>
<form method="post">
    <label>Class Name:</label>
    <input type="text" asp-for="NewClass.ClassName" required />
    <label>Student Count:</label>
    <input type="number" asp-for="NewClass.StudentCount" required />
    <label>Description:</label>
    <input type="text" asp-for="NewClass.Description" required />
    <button type="submit" formaction="?handler=Add">Add</button>
</form>

<style>
    /* Button Styling */
    .btn-sm {
        padding: 5px 10px;
        font-size: 14px;
    }

    .btn-warning {
        background-color: orange;
        border-color: orange;
        color: white;
    }

    .btn-danger {
        background-color: red;
        border-color: red;
        color: white;
    }

    .btn-warning:hover {
        background-color: darkorange;
        border-color: darkorange;
    }

    .btn-danger:hover {
        background-color: darkred;
        border-color: darkred;
    }

    /* Icon Styling */
    i.bi-trash {
        font-size: 16px;
    }

    i.bi-pencil {
        font-size: 16px;
    }
</style>